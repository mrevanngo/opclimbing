# Environment files - never commit secrets
.env
backend/.env
frontend/.env

# Python
__pycache__/
*.pyc
.venv/
*.egg-info/

# Node (frontend has its own .gitignore; belt and braces)
node_modules/
dist/

# Raw climbing clips - never commit (real faces / third-party rights).
