DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres
JWT_SECRET=minimum-32-character-secret-key-here
PORT=8080

# Feedback prose provider: template (default, no LLM/key) | ollama | anthropic
FEEDBACK_PROVIDER=template

# Only used when FEEDBACK_PROVIDER=ollama (local LLM; free, no key).
# Install https://ollama.com then: ollama pull qwen2.5:7b
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Only used when FEEDBACK_PROVIDER=anthropic (optional hosted LLM).
ANTHROPIC_API_KEY=
